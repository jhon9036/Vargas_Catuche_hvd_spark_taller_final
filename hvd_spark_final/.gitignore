# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — hvd_spark_taller
# ─────────────────────────────────────────────────────────────────────────────

# ── Datos grandes (no se suben a GitHub) ─────────────────────────────────────
data/
*.parquet
*.csv
*.zip
*.tar.gz

# ── Entornos virtuales ────────────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.log

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Spark / Hadoop ────────────────────────────────────────────────────────────
derby.log
metastore_db/
spark-warehouse/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverrideAttributes

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Resultados (se incluyen en el repo, comentar si se prefiere excluir) ──────
# outputs/*.png
# outputs/*.html
